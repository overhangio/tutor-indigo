{% if INDIGO_ENABLE_DYNAMIC_THEME %}
RUN --mount=type=cache,target=/root/.npm,sharing=shared \
    npm install --no-audit --no-fund --registry=$NPM_REGISTRY react-colorful@5.6.1
{% endif %}

# Favicon for the frontend-base site: site.config.*.tsx imports @edx/brand/favicon.ico, which
# is the upstream brand placeholder. Replace it with the Indigo theme favicon.
COPY indigo/lms/static/images/favicon.ico /openedx/site/node_modules/@edx/brand/dist/favicon.ico
